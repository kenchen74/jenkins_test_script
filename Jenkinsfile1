pipeline {
    agent any

    parameters {
        string(name: 'ACTION', defaultValue: 'Build', description: 'Action to take')
        string(name: 'CATEGORY', defaultValue: 'Kernel', description: 'Target to be done')
    }

    stages {
        stage('Do Something') {
            steps {
                echo "$Jenkins, ${params.ACTION} the ${params.CATEGORY}!"
            }
        }
    }
}
